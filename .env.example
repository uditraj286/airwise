# Google AI Studio key for Gemini (server-side only, never exposed to the browser)
GEMINI_API_KEY=
# Optional: override the model
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: Google Air Quality API key. Without it AirWise uses the free Open-Meteo air-quality API.
GOOGLE_AIR_QUALITY_API_KEY=
# Set to 1 to serve deterministic sample data (used by e2e tests and offline demos)
AIRWISE_MOCK_DATA=0

# Firebase (Project settings → Your apps → Web app config). Public identifiers; access is enforced by firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
